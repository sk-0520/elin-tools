{
	"name": "elin-tools",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"test": "jest",
		"lint:type": "tsc",
		"lint:script": "biome check .",
		"lint": "npm-run-all --parallel lint:*",
		"lint-fix": "biome check --write .",
		"lint-fix-unsafe": "biome check --write --unsafe .",
		"npm-check": "ncu",
		"npm-update": "ncu -u && npm install && npm run license"
	},
	"jest": {
		"moduleFileExtensions": [
			"ts",
			"js"
		],
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				"tsconfig.json"
			]
		},
		"testMatch": [
			"**/tests/**/*"
		],
		"moduleNameMapper": {
			"@/(.*)$": "<rootDir>/$1"
		},
		"collectCoverage": true,
		"coverageDirectory": "coverage"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mui/icons-material": "^7.1.2",
		"@mui/material": "^7.1.2",
		"leaflet": "^1.9.4",
		"next": "15.3.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.58.1",
		"react-leaflet": "^5.0.0-rc.2",
		"react-leaflet-custom-control": "^1.5.0",
		"recharts": "^3.0.2",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.4",
		"@types/jest": "^30.0.0",
		"@types/leaflet": "^1.9.19",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jest": "^30.0.2",
		"npm-check-updates": "^18.0.1",
		"npm-run-all": "^4.1.5",
		"sharp": "^0.34.2",
		"ts-jest": "^29.4.0",
		"typescript": "^5"
	}
}
