{
	"name": "elin-tools",
	"version": "20250102.0304.05",
	"license": "WTFPL",
	"author": "sk",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sk-0520/elin-tools.git"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build:license": "ts-node --project tsconfig.local.json ./tools/license/license-entry.ts",
		"build:package": "ts-node --project tsconfig.local.json ./tools/package/package-entry.ts",
		"build:app": "next build",
		"build": "npm-run-all --sequential build:license build:package build:app",
		"test": "jest",
		"lint:type": "tsc",
		"lint:code": "biome check .",
		"lint": "npm-run-all --parallel lint:*",
		"lint-fix": "biome check --write .",
		"lint-fix-unsafe": "biome check --write --unsafe .",
		"npm-check": "ncu",
		"npm-update": "ncu -u && npm install && npm run build:license"
	},
	"jest": {
		"moduleFileExtensions": [
			"ts",
			"js"
		],
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				"tsconfig.json"
			]
		},
		"testMatch": [
			"**/tests/**/*.test.ts"
		],
		"setupFiles": [
			"<rootDir>/tests/helper.ts"
		],
		"moduleNameMapper": {
			"@/(.*)$": "<rootDir>/$1"
		},
		"collectCoverage": true,
		"coverageDirectory": "coverage"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.2.0",
		"@mui/material": "^7.2.0",
		"@uiw/react-json-view": "^2.0.0-alpha.33",
		"leaflet": "^1.9.4",
		"next": "15.3.5",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-hook-form": "^7.60.0",
		"react-leaflet": "^5.0.0",
		"react-leaflet-custom-control": "^1.5.0",
		"recharts": "^3.1.0",
		"zustand": "^5.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@types/jest": "^30.0.0",
		"@types/leaflet": "^1.9.20",
		"@types/license-checker": "^25.0.6",
		"@types/node": "^24",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jest": "^30.0.4",
		"license-checker": "^25.0.1",
		"npm-check-updates": "^18.0.1",
		"npm-run-all": "^4.1.5",
		"sharp": "^0.34.3",
		"ts-jest": "^29.4.0",
		"ts-node": "^10.9.2",
		"typescript": "^5"
	}
}
